;; ============================================
;; EWW Dashboard - PipeWire + Brightnessctl
;; ============================================
;; Modular architecture: all widgets in widgets/

(include "widgets/system.yuck")
(include "widgets/media.yuck")
(include "widgets/music.yuck")
(include "widgets/session.yuck")
(include "widgets/wifi_menu.yuck")
(include "./widgets/session-2.yuck")
(include "./widgets/monitor-sidebar.yuck")

;; ============================================
;; VENTANA
;; ============================================
(defwindow dashboard
  :monitor 0
  :geometry (geometry :x "20px" :y "20px" :width "420px" :height "600px" :anchor "top right")
  :stacking "fg"
  :windowtype "normal"
  :wm-ignore false
  (dashboard-widget))

(defwidget dashboard-widget []
  (box
    :class "dashboard-container"
    :orientation "v"
    :spacing 12
    :space-evenly false
    (system-section)
    (media-section)
    (music-section)
    (session-section)))

;; ============================================
;; VENTANA DEL SELECTOR WIFI
;; ============================================
(defwindow wifi_menu
  :monitor 0
  :geometry (geometry :x "0%" :y "5%" :width "300px" :height "400px" :anchor "top right")
  :stacking "fg"
  (wifi-menu-widget :wifi_networks wifi_list))

;; ============================================
;; VENTANA DEL SIDEBAR DE MONITOREO
;; ============================================
(defwindow monitor-sidebar
  :monitor 0
  :geometry (geometry
    :x "0px"
    :y "0px"
    :width "200px"
    :height "420px"
    :anchor "left center"
  )
  :stacking "bg"
  :exclusive true
  :focusable false
  :namespace "monitor-sidebar"
  (monitor-sidebar))

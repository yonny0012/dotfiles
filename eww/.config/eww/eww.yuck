;; =============================================================================
;; Eww Dashboard Configuration
;; Architecture: Wayland (Hyprland) | Yuck Lisp-like Syntax
;; =============================================================================

;; --- [ Variables (Pollers) ] -------------------------------------------------
;; Optimizamos el polleo para no drenar la CPU/batería.
(defpoll time :interval "10s" "date '+%H:%M'")
(defpoll date :interval "1h" "date '+%b %d, %Y'")
(defpoll user :interval "24h" "whoami")

;; Uso de memoria (porcentaje puro)
(defpoll mem_percent :interval "5s" "free -m | awk '/Mem/ {printf \"%d\\n\", ($3/$2) * 100}'")
;; Uso de CPU (usamos top o vmstat simplificado)
(defpoll cpu_percent :interval "5s" "top -b -n 1 | grep 'Cpu(s)' | awk '{print $2 + $4}'")

;; --- [ Window Definition (Wayland Native) ] ----------------------------------
;; Ventana flotante estilo macOS/iOS Control Center
(defwindow dashboard
    :monitor 0
    :geometry (geometry :x "15px"
                        :y "15px"
                        :width "350px"
                        :height "450px"
                        :anchor "top right")
    :stacking "overlay"
    :exclusive false
    :namespace "eww-dashboard"
  (dashboard_layout))

;; --- [ Widgets ] -------------------------------------------------------------
(defwidget dashboard_layout []
  (box :class "dashboard-container"
       :orientation "v"
       :space-evenly false
       :spacing 20
    (profile)
    (sys_resources)))

(defwidget profile []
  (box :class "profile-box"
       :orientation "h"
       :space-evenly false
       :spacing 15
    ;; (image :path "/ruta/a/tu/avatar.png" :image-width 60 :image-height 60)
    (box :class "avatar-placeholder" "")
    (box :orientation "v" :space-evenly false :valign "center"
      (label :class "greeting" :text "Hola, ${user}!" :halign "start")
      (label :class "date-time" :text "${date} | ${time}" :halign "start"))))

(defwidget sys_resources []
  (box :class "sys-box" :orientation "v" :spacing 15
    (box :class "sys-row" :orientation "h" :space-evenly true
      ;; CPU Circular
      (box :class "circular-container" :orientation "v" :space-evenly false :spacing 5
        (circular-progress :value cpu_percent
                           :class "cpu-circle"
                           :thickness 8
                           :start-at 75
          (label :class "circle-icon" :text ""))
        (label :class "circle-label" :text "CPU"))
      
      ;; RAM Circular
      (box :class "circular-container" :orientation "v" :space-evenly false :spacing 5
        (circular-progress :value mem_percent
                           :class "ram-circle"
                           :thickness 8
                           :start-at 75
          (label :class "circle-icon" :text ""))
        (label :class "circle-label" :text "RAM")))))

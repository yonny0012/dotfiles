;; ============================================
;; EWW Dashboard — Liquid Glass Control Center
;; ============================================

(include "widgets/system.yuck")
(include "widgets/media.yuck")
(include "widgets/music.yuck")
(include "widgets/wifi_menu.yuck")
(include "./widgets/session-2.yuck")

;; ============================================
;; HEADER WIDGET
;; ============================================
(defwidget dashboard-header []
  (box
    :class "dashboard-header"
    :orientation "h"
    :space-evenly false
    (box
      :class "header-left"
      :orientation "h"
      :space-evenly false
      :spacing 8
      :halign "start"
      (label :class "header-badge-icon" :text "󰅃")
      (label :class "header-title" :text "Control Center"))
    (box
      :class "header-actions"
      :orientation "h"
      :space-evenly false
      :spacing 8
      :halign "end"
      :hexpand true
      (button
        :class "header-pill-btn"
        :onclick "eww open --toggle wifi_menu"
        :tooltip "Redes Wi-Fi"
        (box
          :spacing 6
          :space-evenly false
          (label :class "header-btn-icon" :text "󰤨")
          (label :class "header-btn-text" :text "Wi-Fi")))
      (button
        :class "header-close-btn"
        :onclick "eww close dashboard"
        :tooltip "Cerrar"
        (label :text "✕")))))

;; ============================================
;; MAIN DASHBOARD CONTAINER
;; ============================================
(defwidget dashboard-widget []
  (box
    :class "dashboard-container"
    :orientation "v"
    :spacing 6
    :space-evenly false
    (dashboard-header)
    (system-section)
    (media-section)
    (music-section)))

;; ============================================
;; WINDOW DEFINITIONS
;; ============================================
(defwindow dashboard
  :monitor 0
  :geometry (geometry :x "16px" :y "20px" :width "420px" :anchor "top right")
  :stacking "fg"
  :namespace "eww-dashboard"
  (dashboard-widget))

(defwindow wifi_menu
  :monitor 0
  :geometry (geometry :x "0%" :y "5%" :width "300px" :height "400px" :anchor "top right")
  :stacking "fg"
  (wifi-menu-widget :wifi_networks wifi_list))

;; ============================================
;; EWW Dashboard - PipeWire + Brightnessctl
;; ============================================
;; Modular architecture: all widgets in widgets/

(include "widgets/system.yuck")
(include "widgets/media.yuck")
(include "widgets/music.yuck")
(include "widgets/session.yuck")

;; ============================================
;; VENTANA
;; ============================================
(defwindow dashboard
  :monitor 0
  :geometry (geometry :x "20px" :y "20px" :width "380px" :height "620px" :anchor "top right")
  :stacking "fg"
  :windowtype "normal"
  :wm-ignore false
  (dashboard-widget))

(defwidget dashboard-widget []
  (box
    :class "dashboard-container"
    :orientation "v"
    :spacing 12
    :space-evenly false
    (system-section)
    (media-section)
    (music-section)
    (session-section)))

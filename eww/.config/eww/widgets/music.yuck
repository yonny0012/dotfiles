;; ============================================
;; Music Player — MPD via mpc (Liquid Glass Card)
;; ============================================

;; --- Poll ---
(defpoll music :interval "1s"
  :initial '{"status":"stopped","song":"Offline","artist":"Offline","progress":0,"ctime":"0:00","ttime":"0:00","cover":""}'
  `scripts/music_info.sh --all`)

;; --- Music section ---
(defwidget music-section []
  (box
    :class "section-box music-box"
    :orientation "v"
    :spacing 10
    :space-evenly false

    ;; Header
    (box
      :class "section-header"
      :orientation "h"
      :spacing 8
      :space-evenly false
      (label :text "󰎈" :class "section-icon")
      (label :text "Multimedia" :class "section-title")
      (label
        :class "music-status-badge ${music.status}"
        :text {music.status == "playing" ? "Reproduciendo" : (music.status == "paused" ? "Pausado" : "Detenido")}
        :halign "end"
        :hexpand true))

    ;; Content: Album Art + Track Info + Transport
    (box
      :orientation "h"
      :spacing 14
      :space-evenly false
      :hexpand true

      ;; Album art
      (box
        :class "album-art"
        :style "background-image: url('${music.cover}');"
        :width 52
        :height 52
        :valign "center")

      ;; Song info & Transport controls
      (box
        :orientation "v"
        :spacing 6
        :space-evenly false
        :hexpand true
        :valign "center"
        (label
          :class "music-song"
          :halign "start"
          :limit-width 22
          :text {music.song ?: "Sin reproducción"})
        (label
          :class "music-artist"
          :halign "start"
          :limit-width 24
          :text {music.artist ?: "—"})

        ;; Transport controls
        (box
          :class "music-controls"
          :orientation "h"
          :spacing 10
          :halign "start"
          :space-evenly false
          (button
            :class "music-btn prev"
            :onclick "scripts/music_info.sh --prev"
            :tooltip "Anterior"
            (label :text "󰒮"))
          (button
            :class "music-btn play ${music.status}"
            :onclick "scripts/music_info.sh --toggle"
            :tooltip "Reproducir / Pausar"
            (label :text "${music.status == 'playing' ? '󰏤' : '󰐊'}"))
          (button
            :class "music-btn next"
            :onclick "scripts/music_info.sh --next"
            :tooltip "Siguiente"
            (label :text "󰒭")))))

    ;; Progress bar
    (box
      :class "music-progress-row"
      :orientation "h"
      :spacing 8
      :space-evenly false
      :valign "center"
      (label :text {music.ctime ?: "0:00"} :class "music-time")
      (scale
        :class "music-slider"
        :hexpand true
        :min 0
        :max 100
        :value {music.progress ?: 0}
        :onchange "mpc -q seek {}%")
      (label :text {music.ttime ?: "0:00"} :class "music-time"))))

;; ============================================
;; Music Player — MPD via mpc
;; ============================================

;; --- Poll ---
;; A single call returns every field as JSON (see scripts/music_info.sh).
(defpoll music :interval "1s"
  :initial '{"status":"stopped","song":"Offline","artist":"Offline","progress":0,"ctime":"0:00","ttime":"0:00","cover":""}'
  `scripts/music_info.sh --all`)

;; --- Music section ---
(defwidget music-section []
  (box
    :class "section-box music-box"
    :orientation "v"
    :spacing 8
    :space-evenly false

    ;; Header
    (box
      :class "section-header"
      :orientation "h"
      :spacing 8
      :space-evenly false
      (label :text "󰎈" :class "section-icon")
      (label :text "Música" :class "section-title"))

    ;; Cover + info
    (box
      :orientation "h"
      :spacing 12
      :space-evenly false
      :hexpand true

      ;; Album art
      (box
        :class "album-art"
        :style "background-image: url('${music.cover}');"
        :width 64
        :height 64)

      ;; Song info + controls
      (box
        :orientation "v"
        :spacing 4
        :space-evenly false
        :hexpand true
        :valign "center"
        (label
          :class "music-song"
          :halign "start"
          :limit-width 22
          :text {music.song ?: "Sin reproducción"})
        (label
          :class "music-artist"
          :halign "start"
          :limit-width 20
          :text {music.artist ?: "—"})))

    ;; Transport controls
    (box
      :orientation "h"
      :spacing 16
      :halign "center"
      :space-evenly false
      (button
        :class "music-btn"
        :onclick "scripts/music_info.sh --prev"
        (label :text "󰒮"))
      (button
        :class "music-btn play"
        :onclick "scripts/music_info.sh --toggle"
        (label :text "${music.status == 'playing' ? '󰏤' : '󰐊'}"))
      (button
        :class "music-btn"
        :onclick "scripts/music_info.sh --next"
        (label :text "󰒭")))

    ;; Progress bar
    (box
      :orientation "h"
      :spacing 8
      :space-evenly false
      (label :text {music.ctime ?: "0:00"} :class "music-time")
      (scale
        :class "music-slider"
        :hexpand true
        :min 0
        :max 100
        :value {music.progress ?: 0}
        :onchange "mpc -q seek {}%")
      (label :text {music.ttime ?: "0:00"} :class "music-time"))))

;; ============================================
;; Widget de Monitoreo del Sistema
;; CPU, RAM, Disco, Red, GPU
;; ============================================

(defpoll cpu_usage :interval "1s" "sh ~/.config/eww/scripts/sysinfo.sh cpu")
(defpoll ram_usage :interval "2s" "sh ~/.config/eww/scripts/sysinfo.sh ram")
(defpoll disk_usage :interval "30s" "sh ~/.config/eww/scripts/sysinfo.sh disk")
(defpoll net_usage :interval "2s" "sh ~/.config/eww/scripts/sysinfo.sh net")
(defpoll gpu_usage :interval "2s" "sh ~/.config/eww/scripts/sysinfo.sh gpu")

(defwidget system-monitor []
  (box
    :class "section-box"
    :orientation "v"
    :spacing 10
    :space-evenly false
    ;; Título de sección
    (box
      :orientation "h"
      :space-evenly false
      (label :text "󰍛" :class "metric-icon cpu")
      (label :text "Sistema" :class "metric-label" :xalign 0.0))
    
    ;; CPU
    (metric-row
      :icon "󰘚"
      :icon-class "cpu"
      :label "CPU"
      :value "${cpu_usage}%"
      :bar-class "bar-cpu"
      :bar-value cpu_usage)
    
    ;; RAM
    (metric-row
      :icon "󰍛"
      :icon-class "ram"
      :label "RAM"
      :value "${ram_usage}%"
      :bar-class "bar-ram"
      :bar-value ram_usage)
    
    ;; Disco
    (metric-row
      :icon "󰋊"
      :icon-class "disk"
      :label "Disco"
      :value "${disk_usage}%"
      :bar-class "bar-disk"
      :bar-value disk_usage)
    
    ;; Red
    (metric-row
      :icon "󰤨"
      :icon-class "net"
      :label "Red"
      :value "${net_usage}"
      :bar-class "bar-net"
      :bar-value "0") ;; La red usa texto, no barra porcentual
    
    ;; GPU (requiere nvidia-smi o similar)
    (metric-row
      :icon "󰢮"
      :icon-class "gpu"
      :label "GPU"
      :value "${gpu_usage}%"
      :bar-class "bar-gpu"
      :bar-value gpu_usage)))

;; Widget reutilizable para cada métrica
(defwidget metric-row [icon icon-class label value bar-class bar-value]
  (box
    :class "metric-row"
    :orientation "h"
    :spacing 10
    :space-evenly false
    :valign "center"
    (label :text icon :class "metric-icon ${icon-class}")
    (label :text label :class "metric-label")
    (box
      :hexpand true
      :halign "end"
      :orientation "h"
      :spacing 8
      (progress
        :class "metric-bar ${bar-class}"
        :value bar-value
        :max 100)
      (label :text value :class "metric-value" :width 50))))
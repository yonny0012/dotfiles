;; ============================================
;; System Metrics — Circular Progress & Glass Cards
;; ============================================

;; --- JSON stream from metric_collector ---
(deflisten metrics
  :initial '{"cpu":0,"ram":0,"disk":0,"swap":0,"gpu":0,"net":0,"cpu_freq":"--","ram_used_gb":"0","ram_total_gb":"0","disk_used_gb":"0","disk_total_gb":"0","gpu_temp":"--","net_down_speed":"0 B/s","net_up_speed":"0 B/s"}'
  `~/.config/eww/scripts/metric_collector.sh stream`)

;; --- Reusable circular metric widget ---
(defwidget circular-metric [value icon label detail color-class]
  (box
    :class "metric-card"
    :orientation "v"
    :spacing 3
    :space-evenly false
    :halign "fill"
    :hexpand true
    (circular-progress
      :class "metric-circle ${color-class}"
      :value {value ?: 0}
      :thickness 4
      :start-at 75
      :clockwise true
      (box
        :class "circle-inner"
        :halign "center"
        :valign "center"
        (label :text "${value}%" :class "circle-value")))
    (box
      :orientation "h"
      :spacing 3
      :space-evenly false
      :halign "center"
      (label :text icon :class "circle-icon ${color-class}")
      (label :text label :class "circle-label"))
    (label :text detail :class "circle-detail")))

;; --- System section ---
(defwidget system-section []
  (box
    :class "section-box"
    :orientation "v"
    :spacing 6
    :space-evenly false

    ;; Header
    (box
      :class "section-header"
      :orientation "h"
      :spacing 6
      :space-evenly false
      (label :text "󰍛" :class "section-icon")
      (label :text "Sistema" :class "section-title"))

    ;; Circular metrics — 4 in 1 row (Bento status pill)
    (box
      :orientation "h"
      :spacing 6
      :space-evenly true
      (circular-metric
        :value {metrics.cpu}
        :icon "󰘚"
        :label "CPU"
        :detail "${metrics.cpu_freq}GHz"
        :color-class "cpu")
      (circular-metric
        :value {metrics.ram}
        :icon "󰍛"
        :label "RAM"
        :detail "${metrics.ram_used_gb}/${metrics.ram_total_gb}G"
        :color-class "ram")
      (circular-metric
        :value {metrics.disk}
        :icon "󰋊"
        :label "Disco"
        :detail "${metrics.disk_used_gb}/${metrics.disk_total_gb}G"
        :color-class "disk")
      (circular-metric
        :value {metrics.gpu}
        :icon "󰢮"
        :label "GPU"
        :detail "${metrics.gpu_temp}"
        :color-class "gpu"))

    ;; Network row — Pill style
    (box
      :class "net-row"
      :orientation "h"
      :spacing 8
      :space-evenly false
      :valign "center"
      (box
        :orientation "h"
        :spacing 5
        :space-evenly false
        (label :text "󰤨" :class "net-icon")
        (label :text "Red" :class "net-label"))
      (box
        :hexpand true
        :halign "end"
        :spacing 6
        (box
          :class "net-badge down"
          :orientation "h"
          :spacing 3
          :space-evenly false
          (label :text "↓" :class "net-arrow down")
          (label :text {metrics.net_down_speed} :class "net-speed"))
        (box
          :class "net-badge up"
          :orientation "h"
          :spacing 3
          :space-evenly false
          (label :text "↑" :class "net-arrow up")
          (label :text {metrics.net_up_speed} :class "net-speed"))))))

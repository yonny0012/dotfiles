;; ============================================
;; Session Control Buttons
;; ============================================

;; Confirmation state for destructive actions
(defvar confirm-action "none")

(defwidget session-section []
  (box
    :class "section-box session-box"
    :orientation "v"
    :spacing 8
    :space-evenly false

    ;; Confirmation banner (visible only when pending)
    (revealer
      :reveal {confirm-action != "none"}
      :transition "slidedown"
      :duration "200ms"
      (box
        :class "confirm-banner"
        :orientation "h"
        :spacing 8
        :space-evenly false
        :halign "center"
        (label
          :text "¿${confirm-action == 'poweroff' ? 'Apagar' : (confirm-action == 'reboot' ? 'Reiniciar' : 'Cerrar sesión')}?"
          :class "confirm-text")
        (button
          :class "confirm-yes"
          :onclick "${confirm-action == 'poweroff' ? 'systemctl poweroff' : (confirm-action == 'reboot' ? 'systemctl reboot' : 'hyprctl dispatch exit || loginctl terminate-user $USER')} & eww update confirm-action=none"
          (label :text "󰄬"))
        (button
          :class "confirm-no"
          :onclick "eww update confirm-action=none"
          (label :text "󰜺"))))

    ;; Buttons row
    (box
      :orientation "h"
      :spacing 10
      :space-evenly true
      :halign "center"

      ;; Cerrar sesión (destructive → confirmation)
      (button
        :class "session-btn logout"
        :onclick "eww update confirm-action=logout"
        :tooltip "Cerrar sesión"
        (label :text "󰍃"))

      ;; Bloquear pantalla (safe → direct)
      (button
        :class "session-btn lock"
        :onclick "hyprlock || loginctl lock-session"
        :tooltip "Bloquear"
        (label :text "󰌾"))

      ;; Reiniciar (destructive → confirmation)
      (button
        :class "session-btn reboot"
        :onclick "eww update confirm-action=reboot"
        :tooltip "Reiniciar"
        (label :text "󰜉"))

      ;; Apagar (destructive → confirmation)
      (button
        :class "session-btn power"
        :onclick "eww update confirm-action=poweroff"
        :tooltip "Apagar"
        (label :text "󰐥")))))

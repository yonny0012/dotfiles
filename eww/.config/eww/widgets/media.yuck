;; ============================================
;; Media Controls: Volumen y Brillo (wpctl + brightnessctl)
;; ============================================

;; --- Polls para estado actual ---
(defpoll volume_level :interval "500ms"
  `wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{print int($2 * 100)}' || echo '0'`)

(defpoll volume_muted :interval "500ms"
  `wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | grep -q MUTED && echo 'true' || echo 'false'`)

(defpoll brightness_level :interval "500ms"
  `brightnessctl -m 2>/dev/null | awk -F, '{print int($4)}' || echo '100'`)

;; --- Media section ---
(defwidget media-section []
  (box
    :class "section-box media-box"
    :orientation "v"
    :spacing 6
    :space-evenly false

    ;; Header
    (box
      :class "section-header"
      :orientation "h"
      :spacing 6
      :space-evenly false
      (label :text "󰕾" :class "section-icon")
      (label :text "Controles" :class "section-title"))

    ;; Volume Card
    (box
      :class "slider-card vol-card"
      :orientation "h"
      :spacing 10
      :space-evenly false
      :valign "center"
      (button
        :onclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
        :class "media-btn ${volume_muted == 'true' ? 'muted' : ''}"
        :tooltip "Silenciar / Activar sonido"
        (label
          :text "${volume_muted == 'true' ? '󰖁' : ((volume_level ?: 0) < 30 ? '󰕿' : ((volume_level ?: 0) < 70 ? '󰖀' : '󰕾'))}"
          :class "media-icon vol"))
      (scale
        :orientation "h"
        :class "media-slider vol"
        :hexpand true
        :value {volume_level ?: 0}
        :min 0
        :max 100
        :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%")
      (label :text "${volume_level}%" :class "media-value" :width 40))

    ;; Brightness Card
    (box
      :class "slider-card bright-card"
      :orientation "h"
      :spacing 10
      :space-evenly false
      :valign "center"
      (box
        :class "media-btn static"
        (label
          :text "${(brightness_level ?: 0) < 30 ? '󰃚' : ((brightness_level ?: 0) < 70 ? '󰃛' : '󰃜')}"
          :class "media-icon bright"))
      (scale
        :orientation "h"
        :class "media-slider bright"
        :hexpand true
        :value {brightness_level ?: 0}
        :min 0
        :max 100
        :onchange "brightnessctl set {}%")
      (label :text "${brightness_level}%" :class "media-value" :width 40))))

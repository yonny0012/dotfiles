# Ignore Agents and AI files
.atl/
.agents/

# Runtime logs (no deben versionarse)
eww_debug.log
*.log

# Ignore all mpd runtime and database files (XDG managed)
mpd/.config/mpd/state
mpd/.config/mpd/log
mpd/.config/mpd/database
mpd/.config/mpd/pid
mpd/.config/mpd/socket
mpd/.config/mpd/sticker.sql

# Except the main configuration file
!mpd/.config/mpd/mpd.conf
